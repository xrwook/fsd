{
  "name": "fsd-test",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run dev:mock",
    "dev:mock": "vite --mode mock",
    "dev:dev": "vite --mode dev",
    "dev:stg": "vite --mode stg",
    "dev:prod": "vite --mode prod",
    "dev:storybook": "storybook dev -p 6006",
    "cleanup:msw": "rm -f dist/mockServiceWorker.js",
    "build": "vite build",
    "build:dev": "tsc && vite build --mode dev && pnpm run cleanup:msw",
    "build:stg": "tsc && vite build --mode stg && pnpm run cleanup:msw",
    "build:prod": "tsc && vite build --mode prod && pnpm run cleanup:msw",
    "build:storybook": "storybook build",
    "start": "vite preview",
    "preview": "vite preview",
    "tsc": "tsc -b ./tsconfig.json --noEmit",
    "typecheck": "pnpm run tsc",
    "test": "vitest",
    "test:ci": "vitest related --run",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "pre-commit": "sh .husky/pre-commit",
    "pre-push": "sh .husky/pre-push",
    "prepare": "husky"
